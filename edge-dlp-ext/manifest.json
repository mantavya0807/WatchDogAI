{
  "manifest_version": 3,
  "name": "EdgeDLP (Prototype)",
  "version": "0.1",
  "description": "On-device detection & obfuscation prototype (browser + native helper)",
  "permissions": ["scripting", "storage", "nativeMessaging", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EdgeDLP"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["notification.js", "file_obfuscator.js", "content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["risky_domains.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
