{
  "manifest_version": 3,
  "name": "EdgeDLP (Prototype)",
  "version": "0.1",
  "description": "On-device detection & obfuscation prototype (browser + native helper)",
  "permissions": ["scripting", "storage", "nativeMessaging", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EdgeDLP"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
